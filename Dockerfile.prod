# Frontend de producción: se compila una vez y lo sirve nginx (nunca Vite en modo desarrollo:
# fue lo que llevó el CPU del servidor de Fogón al 100 %). Desarrollo local: Dockerfile.dev.

# --- Etapa 1: compilar ---
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
# Carpeta de installer/clientes/ cuyo logo va en la app (vacío = logo de Valetec)
ARG CLIENTE=""
ENV CLIENTE=$CLIENTE
RUN npm run build

# --- Etapa 2: servir ---
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
