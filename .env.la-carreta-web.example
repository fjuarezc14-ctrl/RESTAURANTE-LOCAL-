# ================================================================
# LA CARRETA - VERSIÓN WEB (servidor con dominio y HTTPS)
# Copiar a .env.la-carreta-web, completar lo marcado con <...> y seguir docs/SOPORTE.md §6.
#   docker compose -f docker-compose.prod.yml -f docker-compose.https.yml --env-file .env.la-carreta-web up -d --build
# ================================================================
COMPOSE_PROJECT_NAME=la-carreta-web
CLIENTE=la-carreta

# Dominio que apunta a la IP del servidor (registro A). Caddy saca y renueva el certificado HTTPS solo.
DOMINIO=<pos.lacarreta.pe>

# Clave de la base: propia y larga, ANTES del primer arranque (después ya no cambia). Ej.: openssl rand -hex 24
DB_PASSWORD=<clave-larga>

# OBLIGATORIO al mudar la base de la PC del local: el MISMO PIN_SECRET que tiene
# C:\ValetecPOS\app\backend\.env. Con otro, ningún PIN funcionaría.
PIN_SECRET=<copiar-del-local>

# Solo aplica si ningún administrador tiene contraseña (en la base mudada ya tiene la del local)
INITIAL_ADMIN_PASSWORD=<clave-admin>

# En internet siempre con inicio de sesión y cookies seguras (requiere HTTPS)
AUTH_OBLIGATORIA=true
MODO_INSTALACION=web

# Puertos internos (solo 127.0.0.1): al público entra Caddy por 80/443
WEB_PORT=127.0.0.1:5188
BACKEND_PORT=3010
DB_PORT=5445
