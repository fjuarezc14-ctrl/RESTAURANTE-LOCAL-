# ================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — RESTAURANTE VALETEC
# ================================================================

# --- Base de Datos PostgreSQL (Docker / Local) ---
DATABASE_URL="postgresql://local_user:local_password@db:5432/restaurante_local"
PORT=3010

# Restaurantes WEB preconfigurados: 'CLIENTE=hernandez' || 'CLIENTE=la-carreta' || 'CLIENTE=' (genérico)
CLIENTE=""
INITIAL_ADMIN_PIN=""   # opcional; vacío = 1234

# ---- .env.hernandez ----
# COMPOSE_PROJECT_NAME=restaurante-hernandez
# CLIENTE=hernandez
# INITIAL_ADMIN_PIN=1234
# # Puertos seguidos: web, backend, base de datos
# WEB_PORT=5210
# BACKEND_PORT=5211
# DB_PORT=5212

# ---- .env.la-carreta ----
# COMPOSE_PROJECT_NAME=restaurante-la-carreta
# CLIENTE=la-carreta
# INITIAL_ADMIN_PIN=1234
# # Puertos seguidos: web, backend, base de datos
# WEB_PORT=5220
# BACKEND_PORT=5221
# DB_PORT=5222

# --- Datos de Empresa ---
COMPANY_NAME="Valetec Gourmet"
COMPANY_LEGAL_NAME="VALETEC GOURMET S.A.C."
COMPANY_RUC="20600000001"
COMPANY_ADDRESS="Av. Principal 123"
COMPANY_PHONE="987-654-321"

# --- API Consulta DNI/RUC (Opcional - Funciona Offline con Caché Local) ---
APIS_NET_PE_TOKEN=""

# --- Facturación Electrónica (Opcional - Modo Offline por Defecto) ---
NUBEFACT_API_URL=""
NUBEFACT_TOKEN=""
NUBEFACT_SIMULATE_OUTAGE=true

# --- Series y Correlativos Iniciales SUNAT ---
SERIE_FACTURA="F001"
ULTIMO_CORRELATIVO_FACTURA=1
SERIE_BOLETA="B001"
ULTIMO_CORRELATIVO_BOLETA=1

# --- Sesiones y seguridad (scratch/ACUERDOS.md §2) ---
# Secreto para guardar los PIN como hash. Definirlo ANTES del primer arranque del cliente y no cambiarlo:
# si cambia, los PIN guardados dejan de coincidir. Generar con: openssl rand -base64 32
PIN_SECRET=""
# Contraseña inicial del usuario "admin" para activar dispositivos (vacío = se genera y se muestra en el log)
INITIAL_ADMIN_PASSWORD=""
# true: toda la API exige sesión (equipo activado + PIN). false solo para pruebas: deja la API abierta a la red
AUTH_OBLIGATORIA=true
# local (red WiFi, HTTP) | web (detrás de un proxy con HTTPS: cookies Secure y trust proxy)
MODO_INSTALACION=local
# Solo si la web se sirve desde otro dominio que la API (vacío = mismo origen, sin CORS). Separados por coma.
CORS_ORIGIN=""
