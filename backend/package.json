{
  "name": "restaurante-valetec-backend",
  "version": "1.0.0",
  "description": "Backend API para Restaurante Valetec ERP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "db:setup": "npx prisma migrate deploy && node prisma/seed.js",
    "db:seed:clean": "node prisma/seed-clean.js",
    "db:repair": "node scripts/data-repair.js",
    "test": "vitest run",
    "test:db": "docker compose -f test/docker-compose.yml up -d --wait",
    "test:db:down": "docker compose -f test/docker-compose.yml down"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "type": "commonjs"
}
