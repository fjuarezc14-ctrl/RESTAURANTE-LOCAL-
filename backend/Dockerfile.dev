FROM node:22-alpine

WORKDIR /app

# Instalar dependencias del sistema para Prisma
RUN apk add --no-cache openssl postgresql16-client

COPY package.json ./
RUN npm install

# Copiar el schema de Prisma para generar el cliente
COPY prisma ./prisma
RUN npx prisma generate

COPY . .

EXPOSE 3010

CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && node scripts/iniciar-cliente.js && node server.js"]
